# Application Settings
APP_NAME=Sensor-Data-Bridge
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Copy the connection details from your Aiven for MySQL service.
MYSQL_HOST=your-service.aivencloud.com
MYSQL_PORT=12345
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=replace-me
# Relative paths are resolved from the backend directory. Supply this CA file locally.
MYSQL_SSL_CA=certs/aiven-ca.pem

# CORS Settings (comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000"]
