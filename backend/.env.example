# ==============================================================================
# SENSOR DATA BRIDGE - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# --- Application Settings ---
APP_NAME=Sensor-Data-Bridge
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# --- Security & JWT Authentication ---
SECRET_KEY=your-random-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database Connection (Aiven MySQL) ---
MYSQL_HOST=your-mysql-service.aivencloud.com
MYSQL_PORT=27590
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=replace-with-your-db-password
MYSQL_SSL_CA=certs/aiven-ca.pem

# --- Cross-Origin Resource Sharing (CORS) ---
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000", "http://127.0.0.1:5173", "http://127.0.0.1:8000"]
